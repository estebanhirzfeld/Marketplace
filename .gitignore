node_modules
.next
.turbo
dist
build
coverage
.nyc_output

# ── Secretos ────────────────────────────────────────────
# Nunca se suben. `make env-check` verifica que existan localmente.
.env
.env.*
!.env.example

# ── Generados ───────────────────────────────────────────
# El cliente de Prisma se regenera con `make install` o `make db-generate`,
# y turbo.json lo encadena antes de cualquier build. Tenerlo versionado solo
# ensucia los diffs con miles de líneas que nadie escribió.
packages/db/generated/

# El canvas de diseño publicado pesa ~2,5 MB porque lleva el editor embebido.
# Las fuentes son los .dc.html y canvas.json, que sí se versionan.
design/*.html
!design/*.dc.html

# ── Ruido de herramientas ───────────────────────────────
.DS_Store
.atl/.skill-registry.cache.json

# Carpeta de material de trabajo, fuera del proyecto
stuff/

# El lienzo de diseño es un archivo generado de ~2 MB: se rearma desde los
# .dc.html y canvas.json con la herramienta de diseño. La negación es
# necesaria porque los tableros también terminan en .html.
design/*.html
!design/*.dc.html

# Registro de aprovisionamiento: contiene OCIDs e IPs de la cuenta.
# El repositorio es público, así que nunca se versiona.
infra/provision/launch.log
.oci-baseline/
