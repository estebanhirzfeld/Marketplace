generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────

enum UserRole {
  buyer
  seller
  admin
}

enum AssetType {
  youtube
  web
}

enum ListingStatus {
  draft
  under_review
  published
  in_operation
  sold
  rejected
}

enum OperationStatus {
  offer_sent
  negotiating
  contract_pending
  contract_signed
  transfer_in_progress
  asset_in_custody
  payment_received
  completed
  cancelled
}

enum NotificationType {
  oferta_recibida
  contraoferta_recibida
  oferta_aceptada
  oferta_cancelada
  listing_aprobado
  listing_rechazado
  contrato_firmado
  // Al vendedor, en vez de contrato_firmado: a él le toca ceder el control
  // del activo y declararlo.
  cesion_pendiente
  activo_en_custodia
  pago_confirmado
  operacion_completada
  // Faltaba, y el dominio ya lo emitía: cada aviso de denuncia fallaba al
  // guardarse con "Invalid value for argument `type`". El notificador se comía
  // el error, así que la denuncia se registraba y el denunciado nunca se
  // enteraba.
  denuncia_recibida
  // Los avisos dirigidos a la plataforma. Un administrador no recibía ninguno
  // porque no había forma de nombrarlo como destinatario.
  revision_pendiente
  acceso_pendiente
  custodia_pendiente
  liquidacion_pendiente
  // Al vendedor: el admin no encontró su invitación a la plataforma.
  acceso_no_encontrado
  // A los administradores: un vendedor avisó que ya invitó a la plataforma.
  acceso_solicitado
  acceso_confirmado
  // A los administradores, durante el traslado del dominio de un sitio a la
  // cuenta de la plataforma: la invitación está por vencer, venció, o el
  // dominio ya llegó.
  traspaso_recordatorio
  traspaso_vencido
  dominio_en_custodia
  // La entrega del dominio al comprador: a él, que acepte la invitación de
  // Hostinger antes de que venza; a los administradores, que venció.
  entrega_recordatorio
  entrega_vencida
  // Al vendedor: la plataforma rechazó su declaración de cesión.
  cesion_rechazada
}

enum ContractType {
  buyer_nda
  seller_nda
  tripartite
}

// ── Models ─────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  fullName      String
  phone         String?
  country       String?
  dni           String?
  role          UserRole
  isKycVerified Boolean  @default(false)
  passwordHash  String
  createdAt     DateTime @default(now())

  listingsAsSeller   Listing[]
  operationsAsBuyer  Operation[] @relation("BuyerOperations")
  operationsAsSeller Operation[] @relation("SellerOperations")
  contractsAsSigner  Contract[]
  notifications      Notification[]
  paymentAccount     SellerPaymentAccount?
  bankAccounts       SellerBankAccount[]
  youtubeConnections YouTubeConnection[]
  reportsFiled      Report[]      @relation("ReportsFiled")
  reportsReceived    Report[]      @relation("ReportsReceived")

  @@map("users")
}

model Listing {
  id              String        @id @default(uuid())
  sellerId        String
  assetType       AssetType
  assetData       Json
  status          ListingStatus @default(draft)
  askingPrice     Int
  currency        String        @default("USD")
  publishedAt     DateTime?
  rejectionReason String?
  platformAccess  Json?
  // Desnormalizado fuera del Json `platformAccess` para tener integridad
  // referencial y poder responder "qué activos sostiene la cuenta X ahora".
  // Nullable: las constancias anteriores a este cambio quedan sin cuenta
  // asignada, a propósito y sin backfill.
  custodyAccountId String?
  ownershipCheck  Json?
  // Cuándo el vendedor declaró que ya invitó a la plataforma. Declaración, no
  // constancia: la constancia es `platformAccess`.
  platformAccessRequestedAt DateTime?
  createdAt       DateTime      @default(now())

  seller        User           @relation(fields: [sellerId], references: [id])
  custodyAccount CustodyAccount? @relation(fields: [custodyAccountId], references: [id])
  operations    Operation[]
  contracts     Contract[]

  @@index([custodyAccountId])
  @@map("listings")
}

/// La identidad real (cuenta de Google, de registrador) que sostiene activos
/// en custodia de la plataforma. No se borra nunca: las constancias que la
/// referencian tienen que seguir resolviéndose.
model CustodyAccount {
  id         String    @id @default(uuid())
  label      String
  identifier String    @unique
  assetType  AssetType
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())

  listings Listing[]

  @@index([assetType, isActive])
  @@map("custody_accounts")
}

enum ReportReason {
  metricas_falsas
  ingreso_falso
  activo_no_entregado
  activo_recuperado
  pago_no_recibido
  otro
}

enum ReportStatus {
  open
  closed
}

/// Denuncia de una parte contra la otra sobre una operación.
///
/// Ninguno de sus estados dice quién tiene razón: la plataforma no arbitra el
/// fondo del reclamo, deja constancia y reúne la evidencia que registró.
model Report {
  id             String       @id @default(uuid())
  operationId    String
  reportedById   String
  reporterRole   String
  reportedUserId String
  reason         ReportReason
  detail         String
  status         ReportStatus @default(open)
  closedAt       DateTime?
  closedReason   String?
  createdAt      DateTime     @default(now())

  operation    Operation @relation(fields: [operationId], references: [id])
  reportedBy   User      @relation("ReportsFiled", fields: [reportedById], references: [id])
  reportedUser User      @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([reportedById])
  @@index([reportedUserId])
  @@map("reports")
}

model Operation {
  id               String          @id @default(uuid())
  listingId        String
  buyerId          String
  sellerId         String
  status           OperationStatus @default(offer_sent)
  offerPrice       Int
  finalPrice       Int?
  buyerCommission  Int?
  sellerCommission Int?
  buyerPays        Int?
  sellerReceives   Int?
  platformEarns    Int?
  currency         String          @default("USD")
  negotiations     Json            @default("[]")
  // La declaración del vendedor de haber cedido el control del activo.
  // Nullable y aditiva: las operaciones que ya estaban en transfer_in_progress
  // quedan sin ella y se muestran como "declaración sin registrar".
  transferInitiation Json?
  custodyCheck     Json?
  payment          Json?
  // Dónde declaró el comprador que quiere recibir el activo. Nullable y
  // aditiva: una operación vieja no la tiene.
  recipientIdentity Json?
  // Constancia de entrega, espejo de `custodyCheck`. Se registra al cerrar.
  deliveryCheck    Json?
  // Cotizaciones en pesos emitidas (historial, de la más vieja a la más nueva),
  // solo para operaciones no ARS. Nullable y aditiva: una operación vieja o en
  // pesos no la tiene.
  settlementQuotes Json?
  completedAt      DateTime?
  // Hitos sin otra constancia con fecha (la firma, la entrega declarada), que
  // anclan los plazos del traspaso. Nullable y aditiva.
  milestones       Json?
  // El rechazo de la última declaración de cesión, con su motivo, hasta que el
  // vendedor declare de nuevo. Nullable y aditiva.
  transferRejection Json?
  createdAt        DateTime        @default(now())

  listing   Listing    @relation(fields: [listingId], references: [id])
  buyer     User       @relation("BuyerOperations", fields: [buyerId], references: [id])
  seller    User       @relation("SellerOperations", fields: [sellerId], references: [id])
  contracts Contract[]
  reports   Report[]

  @@map("operations")
}

model Contract {
  id                  String       @id @default(uuid())
  type                ContractType
  listingId           String
  operationId         String?
  signerId            String?
  signatures          Json
  externalSignatureId String?
  fileUrl             String?
  documentHash        String?
  createdAt           DateTime     @default(now())

  listing   Listing    @relation(fields: [listingId], references: [id])
  operation Operation? @relation(fields: [operationId], references: [id])
  signer    User?      @relation(fields: [signerId], references: [id])

  @@unique([listingId, signerId, type])
  @@map("contracts")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  operationId String?
  listingId   String?
  amountCents Int?
  currency    String?
  occursAt    DateTime?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  // La bandeja se consulta siempre por usuario y ordenada por fecha.
  @@index([userId, createdAt])
  @@map("notifications")
}

/// La cuenta de Mercado Pago que el vendedor vinculó para cobrar. Una por
/// usuario. Los tokens se guardan cifrados (AES-256-GCM): las columnas `*Cipher`
/// nunca contienen el texto plano.
model SellerPaymentAccount {
  id                 String   @id @default(uuid())
  userId             String   @unique
  mpUserId           String   @unique
  accessTokenCipher  String
  refreshTokenCipher String
  expiresAt          DateTime
  scope              String
  linkedAt           DateTime
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_payment_accounts")
}

/// La cuenta bancaria donde un vendedor cobra por transferencia, una por
/// moneda. Va un CBU o un alias, nunca los dos.
model SellerBankAccount {
  id         String   @id @default(uuid())
  userId     String
  currency   String
  cbu        String?
  alias      String?
  holder     String
  declaredAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("seller_bank_accounts")
}

/// La conexión de un vendedor con un canal de YouTube. Una por vendedor y
/// canal. El token de actualización se guarda cifrado (AES-256-GCM): la base
/// nunca lo ve en claro.
model YouTubeConnection {
  id                 String   @id @default(uuid())
  sellerId           String
  channelId          String
  channelTitle       String
  grantedScopes      String[]
  refreshTokenCipher String
  /// `active` o `disconnected`; el mapper valida el valor al leer.
  status             String   @default("active")
  connectedAt        DateTime
  lastReadAt         DateTime
  /// Última lectura de Analytics (fechas ISO); el mapper la rehidrata.
  lastSnapshot       Json
  updatedAt          DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, channelId])
  @@map("youtube_connections")
}

/// Progreso de un paso del traspaso de un activo o de una operación. `scopeId`
/// apunta a un activo o a una operación según `scope`, por eso no lleva clave
/// foránea. Sin fila, el paso está pendiente y sin plazo.
model TransferStepProgress {
  id            String    @id @default(uuid())
  /// `listing` u `operation`; el mapper valida el valor al leer.
  scope         String
  scopeId       String
  /// La `key` estable del paso en la estrategia del activo.
  stepKey       String
  /// `pending`, `waiting`, `done`, `expired` o `rejected`; el mapper valida el valor al leer.
  status        String    @default("pending")
  startedAt     DateTime
  deadlineAt    DateTime?
  lastCheckedAt DateTime?
  remindedAt    DateTime?
  escalatedAt   DateTime?
  /// Lo observado al comprobar el paso; el mapper valida que sea un objeto.
  evidence      Json      @default("{}")
  /// Id del usuario que declaró cumplido el paso; sin relación, como `scopeId`.
  attestedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([scope, scopeId, stepKey])
  @@index([status])
  @@map("transfer_step_progress")
}
