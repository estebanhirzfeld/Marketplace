generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────

enum UserRole {
  buyer
  seller
  admin
}

enum AssetType {
  youtube
  web
}

enum ListingStatus {
  draft
  under_review
  published
  in_operation
  sold
  rejected
}

enum OperationStatus {
  offer_sent
  negotiating
  contract_pending
  contract_signed
  transfer_in_progress
  asset_in_custody
  payment_received
  completed
  cancelled
}

enum NotificationType {
  oferta_recibida
  contraoferta_recibida
  oferta_aceptada
  oferta_cancelada
  listing_aprobado
  listing_rechazado
  contrato_firmado
  activo_en_custodia
  pago_confirmado
  operacion_completada
  // Faltaba, y el dominio ya lo emitía: cada aviso de denuncia fallaba al
  // guardarse con "Invalid value for argument `type`". El notificador se comía
  // el error, así que la denuncia se registraba y el denunciado nunca se
  // enteraba.
  denuncia_recibida
}

enum ContractType {
  buyer_nda
  seller_nda
  tripartite
}

// ── Models ─────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  fullName      String
  phone         String?
  country       String?
  dni           String?
  role          UserRole
  isKycVerified Boolean  @default(false)
  passwordHash  String
  createdAt     DateTime @default(now())

  listingsAsSeller   Listing[]
  operationsAsBuyer  Operation[] @relation("BuyerOperations")
  operationsAsSeller Operation[] @relation("SellerOperations")
  contractsAsSigner  Contract[]
  notifications      Notification[]
  reportsFiled       Report[]      @relation("ReportsFiled")
  reportsReceived    Report[]      @relation("ReportsReceived")

  @@map("users")
}

model Listing {
  id              String        @id @default(uuid())
  sellerId        String
  assetType       AssetType
  assetData       Json
  status          ListingStatus @default(draft)
  askingPrice     Int
  currency        String        @default("USD")
  publishedAt     DateTime?
  rejectionReason String?
  platformAccess  Json?
  ownershipCheck  Json?
  createdAt       DateTime      @default(now())

  seller     User        @relation(fields: [sellerId], references: [id])
  operations Operation[]
  contracts  Contract[]

  @@map("listings")
}

enum ReportReason {
  metricas_falsas
  ingreso_falso
  activo_no_entregado
  activo_recuperado
  pago_no_recibido
  otro
}

enum ReportStatus {
  open
  closed
}

/// Denuncia de una parte contra la otra sobre una operación.
///
/// Ninguno de sus estados dice quién tiene razón: la plataforma no arbitra el
/// fondo del reclamo, deja constancia y reúne la evidencia que registró.
model Report {
  id             String       @id @default(uuid())
  operationId    String
  reportedById   String
  reporterRole   String
  reportedUserId String
  reason         ReportReason
  detail         String
  status         ReportStatus @default(open)
  closedAt       DateTime?
  closedReason   String?
  createdAt      DateTime     @default(now())

  operation    Operation @relation(fields: [operationId], references: [id])
  reportedBy   User      @relation("ReportsFiled", fields: [reportedById], references: [id])
  reportedUser User      @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([reportedById])
  @@index([reportedUserId])
  @@map("reports")
}

model Operation {
  id               String          @id @default(uuid())
  listingId        String
  buyerId          String
  sellerId         String
  status           OperationStatus @default(offer_sent)
  offerPrice       Int
  finalPrice       Int?
  buyerCommission  Int?
  sellerCommission Int?
  buyerPays        Int?
  sellerReceives   Int?
  platformEarns    Int?
  currency         String          @default("USD")
  negotiations     Json            @default("[]")
  custodyCheck     Json?
  payment          Json?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())

  listing   Listing    @relation(fields: [listingId], references: [id])
  buyer     User       @relation("BuyerOperations", fields: [buyerId], references: [id])
  seller    User       @relation("SellerOperations", fields: [sellerId], references: [id])
  contracts Contract[]
  reports   Report[]

  @@map("operations")
}

model Contract {
  id                  String       @id @default(uuid())
  type                ContractType
  listingId           String
  operationId         String?
  signerId            String?
  signatures          Json
  externalSignatureId String?
  fileUrl             String?
  documentHash        String?
  createdAt           DateTime     @default(now())

  listing   Listing    @relation(fields: [listingId], references: [id])
  operation Operation? @relation(fields: [operationId], references: [id])
  signer    User?      @relation(fields: [signerId], references: [id])

  @@unique([listingId, signerId, type])
  @@map("contracts")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  operationId String?
  listingId   String?
  amountCents Int?
  currency    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  // La bandeja se consulta siempre por usuario y ordenada por fecha.
  @@index([userId, createdAt])
  @@map("notifications")
}
