# ─────────────────────────────────────────────────────────────────────────────
# Inventario de variables de entorno del marketplace. SOLO CLAVES, SIN VALORES.
#
# NOTA DE NOMBRE: el archivo convencional sería `.env.example`, pero el tooling
# del asistente tiene bloqueado todo archivo que empiece con `.env`, así que la
# referencia versionada vive como `env.example`. No lo consume ningún proceso:
# es documentación. En la VM los valores reales van en tres archivos 0600
# descritos en infra/README.md:
#   /etc/marketplace/api.env            -> EnvironmentFile de marketplace-api
#   /etc/marketplace/web.env            -> EnvironmentFile de marketplace-web
#   /srv/marketplace/packages/db/.env   -> lo lee prisma.config.ts (dotenv)
#
# El repositorio es público: acá NUNCA va un valor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Comunes ──────────────────────────────────────────────────────────────────
# Entorno de ejecución. En producción DEBE ser "production": activa la cookie
# de sesión Secure (apps/web/src/lib/session.ts) y el logger de la API.
NODE_ENV=

# ── API (apps/api) — archivo /etc/marketplace/api.env ────────────────────────
# Puerto donde escucha Fastify. En producción: 3001 (systemd lo fija), 127.0.0.1.
PORT=

# Clave para firmar los JWT. Generar fresca en la VM, nunca reusar la de dev:
#   openssl rand -base64 48
# Si falta, la API aborta el arranque nombrando la variable.
JWT_SECRET=

# Cadena de conexión a Postgres. La consumen la API y el CLI de Prisma.
# En producción DEBE nombrar la base "marketplace" (NO "marketplace_dev").
# Es el error de copy-paste más probable y falla tarde, después de /health:
#   postgresql://marketplace:<password>@127.0.0.1:5434/marketplace
DATABASE_URL=

# ── Web (apps/web) — archivo /etc/marketplace/web.env ────────────────────────
# URL interna de la API que usa el código server-side de Next. Nunca pública:
#   http://127.0.0.1:3001
API_URL=

# URL pública del sitio. La usan los redirects OAuth y los enlaces absolutos:
#   https://traspaso.forzalabs.online
NEXT_PUBLIC_APP_URL=

# Interruptor reversible de indexado por buscadores. Por defecto INDEXABLE.
# Se apaga solo con un valor negativo explícito: "false", "0", "off", "no".
# Cambiarlo NO requiere rebuild: apps/web/src/app/robots.ts es force-dynamic.
# En la VM se deja en "true".
SEARCH_INDEXING=

# ── MercadoPago (ACTIVO en este despliegue) — /etc/marketplace/api.env ───────
# Token de acceso de la aplicación de MercadoPago. Si queda vacío, las rutas de
# checkout quedan deshabilitadas (crearCheckout undefined en el container).
MERCADOPAGO_ACCESS_TOKEN=

# Secreto del webhook, para validar la firma x-signature de los avisos.
MERCADOPAGO_WEBHOOK_SECRET=

# URL de retorno del checkout, sobre el host público:
#   https://traspaso.forzalabs.online/operaciones
MERCADOPAGO_BACK_URL=

# URL a la que MercadoPago manda los avisos de pago. Caddy la proxya directo a
# Fastify (única excepción a la topología localhost-only de la API):
#   https://traspaso.forzalabs.online/webhooks/mercadopago
MERCADOPAGO_NOTIFICATION_URL=

# ── Google / YouTube (DESHABILITADO en este despliegue) ──────────────────────
# Intencionalmente sin definir. Con estas variables vacías, las rutas de
# verificación con YouTube/Google devuelven 503 por diseño (no 500).
# Habilitarlas después es un cambio de un solo paso: completar los valores.
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=
