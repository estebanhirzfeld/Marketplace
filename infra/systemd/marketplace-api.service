# marketplace-api — API Fastify (apps/api) como artefacto ESM bundleado.
#
# Instalar:
#   sudo cp infra/systemd/marketplace-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now marketplace-api
#
# ExecStart apunta al bundle .mjs que produce `pnpm --filter @marketplace/api
# build` (tsup). Ver docs/fase-12-despliegue.md.
[Unit]
Description=Marketplace API (Fastify)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/marketplace/apps/api
EnvironmentFile=/etc/marketplace/api.env
ExecStart=/usr/bin/node /srv/marketplace/apps/api/dist/server.mjs
Restart=always
RestartSec=5
# El server.ts hace listen en 0.0.0.0:PORT; en la VM el puerto 3001 solo es
# alcanzable desde loopback porque la security list y iptables no lo abren.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
